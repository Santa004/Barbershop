# Nyckel från https://resend.com/api-keys
# Saknas den byggs sajten ändå, och formuläret visar mejladress och telefon i stället.
RESEND_API_KEY=

# Avsändaradress i Resend. Domänen måste vara verifierad i Resend.
# Utan verifierad domän: lämna tomt, då används onboarding@resend.dev.
RESEND_FROM=

# Sajtens publika adress, används för sitemap, canonical och og-bilder.
# Lämna tomt på Vercel så används projektets produktionsadress automatiskt.
NEXT_PUBLIC_SITE_URL=
